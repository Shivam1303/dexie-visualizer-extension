{
  "manifest_version": 3,
  "name": "IndexedDB Workbench",
  "version": "1.0.0",
  "description": "Browse and edit a live page's IndexedDB in a full-page workspace.",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Inspect this tab's IndexedDB",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": { "service_worker": "src/background/background.ts", "type": "module" }
}
